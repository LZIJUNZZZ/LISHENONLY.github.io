/* ============================================================
 * questionnaire.js — 问卷模块（完整版）
 * 功能：
 *   1. 双栏问答记录（我问 TA / TA 问我）
 *   2. 问题与回答同步到主聊天记录
 *   3. "字卡回复"选项：勾选后梦角主动发一条字卡
 *   4. 梦角反应时间自由设置
 *   5. 梦角主动提问（可开关 + 自定义提问池）
 * ============================================================ */
(function () {
  'use strict';

  /* ============================================================
   * 一、常量与默认设置
   * ============================================================ */
  const RECORDS_KEY  = 'qn_records_v1';
  const SETTINGS_KEY = 'qn_settings_v1';
  const FALLBACK_CHAT_KEY = 'qn_chat_fallback_v1';

  const DEFAULT_SETTINGS = {
    /* 我问 TA 后，TA 回答的反应时间（毫秒） */
    answerDelayMin: 3000,
    answerDelayMax: 8000,
    /* TA 主动问我问题的间隔（毫秒） */
    askDelayMin: 20000,
    askDelayMax: 60000,
    /* 是否开启 TA 主动提问 */
    autoAskEnabled: false,
    /* TA 主动提问池 */
    autoAskPool: [
      '你今天心情怎么样？',
      '最近有没有什么想做的事？',
      '你还记得我们第一次说话是什么时候吗？',
      '如果明天可以什么都不做，你想干什么？',
      '有没有什么话，一直想跟我说但没说出口？'
    ],
    /* 无字卡系统时的降级字卡池 */
    fallbackCards: [
      '（字卡）今天也想你了。',
      '（字卡）要好好吃饭哦。',
      '（字卡）我在的。',
      '（字卡）早点休息。',
      '（字卡）记得想我。'
    ]
  };

  /* ============================================================
   * 二、存储适配层
   * ============================================================ */
  const Storage = {
    async get(key, fallback) {
      try {
        if (window.App && window.App.storage && typeof window.App.storage.get === 'function') {
          const v = await window.App.storage.get(key);
          return (v === null || v === undefined) ? fallback : v;
        }
        const raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
      } catch (e) {
        console.warn('[QN] storage.get 失败:', key, e);
        return fallback;
      }
    },
    async set(key, val) {
      try {
        if (window.App && window.App.storage && typeof window.App.storage.set === 'function') {
          return await window.App.storage.set(key, val);
        }
        localStorage.setItem(key, JSON.stringify(val));
      } catch (e) {
        console.warn('[QN] storage.set 失败:', key, e);
      }
    }
  };

  /* ============================================================
   * 三、运行状态
   * ============================================================ */
  let records  = [];
  let settings = Object.assign({}, DEFAULT_SETTINGS);
  const timers = { answer: new Map(), ask: null };

  /* ============================================================
   * 四、工具函数
   * ============================================================ */
  const $ = function (sel, root) { return (root || document).querySelector(sel); };

  function uid() {
    return 'qn_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
  }

  function rand(min, max) {
    if (max <= min) return min;
    return Math.floor(min + Math.random() * (max - min));
  }

  function fmtTime(ts) {
    const d = new Date(ts);
    const p = function (n) { return String(n).padStart(2, '0'); };
    return p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
    });
  }

  /* ============================================================
   * 五、桥接层（与你的现有系统对接）
   *
   * 若你的主程序暴露了相应函数，会自动调用；
   * 也可以在外部手动覆盖：
   *   window.Questionnaire.setBridge({
   *     pushToChat(msg) { ... },
   *     drawCard() { ... },
   *     makeTextReply(q) { ... }
   *   });
   * ============================================================ */
  const Bridge = {
    /* ---- 往主聊天记录推一条消息 ---- */
    async pushToChat(msg) {
      const App = window.App || {};

      if (typeof App.pushMessage === 'function') return App.pushMessage(msg);
      if (typeof App.addMessage  === 'function') return App.addMessage(msg);
      if (typeof window.pushMessage === 'function') return window.pushMessage(msg);
      if (typeof window.addMessage  === 'function') return window.addMessage(msg);

      /* 广播自定义事件，供主程序监听 */
      try {
        window.dispatchEvent(new CustomEvent('qn:message', { detail: msg }));
      } catch (e) { /* ignore */ }

      /* 最终降级：写入独立的 fallback 存储，至少不丢数据 */
      try {
        const list = JSON.parse(localStorage.getItem(FALLBACK_CHAT_KEY) || '[]');
        list.push(msg);
        localStorage.setItem(FALLBACK_CHAT_KEY, JSON.stringify(list));
      } catch (e) { /* ignore */ }

      console.warn('[QN] 未找到聊天推送接口，消息已存入 fallback：', msg);
    },

    /* ---- 抽一张字卡 ---- */
    async drawCard() {
      const App = window.App || {};

      if (typeof App.drawCard   === 'function') return await App.drawCard();
      if (typeof App.randomCard === 'function') return await App.randomCard();
      if (window.Cards && typeof window.Cards.random === 'function') return await window.Cards.random();
      if (typeof window.drawCard === 'function') return await window.drawCard();

      /* 降级：从设置里的 fallbackCards 随机取一张 */
      const pool = (settings.fallbackCards && settings.fallbackCards.length)
        ? settings.fallbackCards
        : DEFAULT_SETTINGS.fallbackCards;
      const text = pool[Math.floor(Math.random() * pool.length)];
      return { id: uid(), text: text };
    },

    /* ---- 生成一句普通文本回复 ---- */
    async makeTextReply(question) {
      const App = window.App || {};

      if (typeof App.generateReply === 'function') return await App.generateReply(question);
      if (typeof App.replyTo       === 'function') return await App.replyTo(question);

      const replies = ['……嗯，我想想。', '好，我知道了。', '嗯，你说的我记下了。', '让我想想怎么回答你。'];
      return replies[Math.floor(Math.random() * replies.length)];
    }
  };

  /* ============================================================
   * 六、持久化
   * ============================================================ */
  async function persist() {
    await Storage.set(RECORDS_KEY, records);
  }

  async function persistSettings() {
    await Storage.set(SETTINGS_KEY, settings);
  }

  /* ============================================================
   * 七、核心业务：我问 TA
   * ============================================================ */
  async function askQuestion(text, expectCard) {
    text = String(text || '').trim();
    if (!text) return null;

    const rec = {
      id: uid(),
      direction: 'out',          /* out = 我问 TA */
      text: text,
      createdAt: Date.now(),
      status: 'pending',
      expectCard: !!expectCard,  /* 是否要求字卡回复 */
      answer: null,
      answeredAt: null,
      answerType: null
    };

    records.push(rec);
    await persist();

    /* 同步到主聊天记录 */
    await Bridge.pushToChat({
      role: 'me',
      type: 'text',
      content: text,
      qnId: rec.id,
      ts: rec.createdAt
    });

    render();
    scheduleAnswer(rec);
    return rec;
  }

  /* 安排 TA 的回答（反应时间在此生效） */
  function scheduleAnswer(rec) {
    const delay = rand(settings.answerDelayMin, settings.answerDelayMax);
    const t = setTimeout(function () { resolveAnswer(rec.id); }, delay);
    timers.answer.set(rec.id, t);
  }

  /* TA 实际作答 */
  async function resolveAnswer(recId) {
    const rec = records.find(function (r) { return r.id === recId; });
    if (!rec || rec.status === 'answered') return;
    timers.answer.delete(recId);

    let answerType, chatMsg;

    if (rec.expectCard) {
      /* ---- 字卡回复：TA 主动发一条字卡 ---- */
      const card = await Bridge.drawCard();
      const cardText = (card && (card.text || card.content)) || '（字卡）';

      answerType = 'card';
      rec.answer = cardText;
      chatMsg = {
        role: 'her',
        type: 'card',
        content: cardText,
        card: card,
        qnId: rec.id,
        ts: Date.now()
      };
    } else {
      /* ---- 普通文本回复 ---- */
      const text = await Bridge.makeTextReply(rec.text);
      answerType = 'text';
      rec.answer = text;
      chatMsg = {
        role: 'her',
        type: 'text',
        content: text,
        qnId: rec.id,
        ts: Date.now()
      };
    }

    rec.status = 'answered';
    rec.answeredAt = Date.now();
    rec.answerType = answerType;
    await persist();

    await Bridge.pushToChat(chatMsg);
    render();
  }

  /* ============================================================
   * 八、核心业务：TA 问我
   * ============================================================ */
  async function herAsk(customText) {
    let text = customText;

    if (!text) {
      const pool = (settings.autoAskPool && settings.autoAskPool.length)
        ? settings.autoAskPool
        : DEFAULT_SETTINGS.autoAskPool;
      text = pool[Math.floor(Math.random() * pool.length)];
    }

    const rec = {
      id: uid(),
      direction: 'in',           /* in = TA 问我 */
      text: text,
      createdAt: Date.now(),
      status: 'asked',
      expectCard: false,
      answer: null,
      answeredAt: null,
      answerType: null
    };

    records.push(rec);
    await persist();

    await Bridge.pushToChat({
      role: 'her',
      type: 'text',
      content: text,
      qnId: rec.id,
      ts: rec.createdAt
    });

    render();
    return rec;
  }

  /* 我回答 TA 的问题 */
  async function answerHerQuestion(recId, text) {
    const rec = records.find(function (r) { return r.id === recId; });
    if (!rec || rec.direction !== 'in') return;
    if (!String(text || '').trim()) return;

    rec.status = 'answered';
    rec.answer = String(text).trim();
    rec.answeredAt = Date.now();
    rec.answerType = 'text';
    await persist();

    await Bridge.pushToChat({
      role: 'me',
      type: 'text',
      content: rec.answer,
      qnId: rec.id,
      ts: rec.answeredAt
    });

    render();
  }

  /* ============================================================
   * 九、定时器：TA 主动提问
   * ============================================================ */
  function scheduleAutoAsk() {
    if (timers.ask) {
      clearTimeout(timers.ask);
      timers.ask = null;
    }
    if (!settings.autoAskEnabled) return;

    const delay = rand(settings.askDelayMin, settings.askDelayMax);
    timers.ask = setTimeout(async function () {
      await herAsk();
      scheduleAutoAsk();
    }, delay);
  }

  /* ============================================================
   * 十、渲染
   * ============================================================ */
  function renderList(dir) {
    const ul = $(dir === 'out' ? '#qn-list-out' : '#qn-list-in');
    if (!ul) return;

    const list = records
      .filter(function (r) { return r.direction === dir; })
      .sort(function (a, b) { return b.createdAt - a.createdAt; });

    if (!list.length) {
      ul.innerHTML = '<li class="qn-empty">' +
        (dir === 'out' ? '还没有问过问题' : 'TA 还没问过你') +
        '</li>';
      return;
    }

    ul.innerHTML = list.map(function (r) {
      /* 状态徽章 */
      let badge;
      if (r.status === 'answered') {
        badge = '<span class="qn-badge qn-badge--done">已回答</span>';
      } else if (dir === 'out') {
        badge = '<span class="qn-badge qn-badge--pending">等待中…</span>';
      } else {
        badge = '<span class="qn-badge qn-badge--pending">待你回答</span>';
      }

      /* 字卡标记 */
      const cardFlag = r.expectCard
        ? '<span class="qn-badge qn-badge--card">字卡</span>'
        : '';

      /* 回答区块 */
      let answerBlock = '';
      if (r.answer) {
        answerBlock =
          '<div class="qn-answer">' +
            '<span class="qn-answer-label">' + (r.direction === 'out' ? 'TA' : '我') + '：</span>' +
            '<span class="qn-answer-text">' + escapeHtml(r.answer) + '</span>' +
          '</div>';
      } else if (dir === 'in' && r.status !== 'answered') {
        answerBlock =
          '<div class="qn-reply-bar">' +
            '<input class="qn-reply-input" data-id="' + r.id + '" placeholder="回答 TA…" />' +
            '<button class="qn-reply-btn" data-id="' + r.id + '">发送</button>' +
          '</div>';
      }

      return '<li class="qn-item" data-id="' + r.id + '">' +
        '<div class="qn-item-head">' +
          '<span class="qn-time">' + fmtTime(r.createdAt) + '</span>' +
          badge + cardFlag +
        '</div>' +
        '<div class="qn-question">' + escapeHtml(r.text) + '</div>' +
        answerBlock +
      '</li>';
    }).join('');

    /* 绑定"我的回答"按钮 */
    ul.querySelectorAll('.qn-reply-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-id');
        const input = ul.querySelector('.qn-reply-input[data-id="' + id + '"]');
        if (input && input.value.trim()) {
          answerHerQuestion(id, input.value.trim());
        }
      });
    });

    /* 回车提交 */
    ul.querySelectorAll('.qn-reply-input').forEach(function (input) {
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          const id = input.getAttribute('data-id');
          const btn = ul.querySelector('.qn-reply-btn[data-id="' + id + '"]');
          if (btn) btn.click();
        }
      });
    });
  }

  function renderSettings() {
    const m  = $('#qn-set-answer-min');
    const M  = $('#qn-set-answer-max');
    const am = $('#qn-set-ask-min');
    const AM = $('#qn-set-ask-max');
    if (!m) return;

    m.value  = settings.answerDelayMin / 1000;
    M.value  = settings.answerDelayMax / 1000;
    am.value = settings.askDelayMin / 1000;
    AM.value = settings.askDelayMax / 1000;

    const chk = $('#qn-set-autoask');
    if (chk) chk.checked = !!settings.autoAskEnabled;

    const pool = $('#qn-set-pool');
    if (pool) pool.value = (settings.autoAskPool || []).join('\n');
  }

  function render() {
    renderList('out');
    renderList('in');
    renderSettings();
  }

  /* ============================================================
   * 十一、事件绑定
   * ============================================================ */
  function bindEvents() {
    const openBtn  = $('#qn-open-btn');
    const closeBtn = $('#qn-close-btn');
    const setBtn   = $('#qn-settings-btn');
    const sendBtn  = $('#qn-send-btn');
    const input    = $('#qn-input');

    if (openBtn)  openBtn.addEventListener('click', open);
    if (closeBtn) closeBtn.addEventListener('click', close);

    if (setBtn) {
      setBtn.addEventListener('click', function () {
        const p = $('#qn-settings');
        if (p) p.hidden = !p.hidden;
      });
    }

    if (sendBtn) {
      sendBtn.addEventListener('click', function () {
        const inp = $('#qn-input');
        const cardChk = $('#qn-expect-card');
        if (inp && inp.value.trim()) {
          askQuestion(inp.value, cardChk ? cardChk.checked : false);
          inp.value = '';
          if (cardChk) cardChk.checked = false;
        }
      });
    }

    if (input) {
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && sendBtn) sendBtn.click();
      });
    }

    /* ---- 设置项保存 ---- */
    const save = async function () {
      function num(sel, dft) {
        const el = $(sel);
        if (!el) return dft;
        const v = parseFloat(el.value);
        return isNaN(v) ? dft : Math.max(0, v * 1000);
      }

      settings.answerDelayMin = num('#qn-set-answer-min', settings.answerDelayMin);
      settings.answerDelayMax = num('#qn-set-answer-max', settings.answerDelayMax);
      settings.askDelayMin    = num('#qn-set-ask-min',    settings.askDelayMin);
      settings.askDelayMax    = num('#qn-set-ask-max',    settings.askDelayMax);

      if (settings.answerDelayMax < settings.answerDelayMin)
        settings.answerDelayMax = settings.answerDelayMin;
      if (settings.askDelayMax < settings.askDelayMin)
        settings.askDelayMax = settings.askDelayMin;

      const chk = $('#qn-set-autoask');
      if (chk) settings.autoAskEnabled = chk.checked;

      const pool = $('#qn-set-pool');
      if (pool) {
        settings.autoAskPool = pool.value
          .split('\n')
          .map(function (s) { return s.trim(); })
          .filter(Boolean);
      }

      await persistSettings();
      scheduleAutoAsk();
    };

    ['#qn-set-answer-min', '#qn-set-answer-max', '#qn-set-ask-min',
     '#qn-set-ask-max', '#qn-set-autoask', '#qn-set-pool'].forEach(function (sel) {
      const el = $(sel);
      if (!el) return;
      el.addEventListener('change', save);
      el.addEventListener('blur', save);
    });
  }

  /* ============================================================
   * 十二、打开 / 关闭
   * ============================================================ */
  function open() {
    const p = $('#qn-panel');
    if (p) p.hidden = false;
    render();
  }

  function close() {
    const p = $('#qn-panel');
    if (p) p.hidden = true;
  }

  /* ============================================================
   * 十三、初始化
   * ============================================================ */
  async function init() {
    records  = await Storage.get(RECORDS_KEY, []);
    const saved = await Storage.get(SETTINGS_KEY, {});
    settings = Object.assign({}, DEFAULT_SETTINGS, saved);

    bindEvents();
    render();
    scheduleAutoAsk();

    console.log('[QN] 问卷模块已加载');
  }

  /* ============================================================
   * 十四、对外 API
   * ============================================================ */
  window.Questionnaire = {
    init: init,
    open: open,
    close: close,

    ask: askQuestion,
    herAsk: herAsk,
    answerHer: answerHerQuestion,

    getRecords: function () { return records.slice(); },
    getSettings: function () { return Object.assign({}, settings); },

    /* 允许外部覆盖桥接实现 */
    setBridge: function (impl) {
      if (!impl) return;
      if (typeof impl.pushToChat === 'function')    Bridge.pushToChat = impl.pushToChat;
      if (typeof impl.drawCard === 'function')      Bridge.drawCard = impl.drawCard;
      if (typeof impl.makeTextReply === 'function') Bridge.makeTextReply = impl.makeTextReply;
    },

    /* 清空问卷记录（不删设置） */
    clearRecords: async function () {
      records = [];
      await persist();
      render();
    }
  };

  /* 启动 */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
